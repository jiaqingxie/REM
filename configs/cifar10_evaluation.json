{
  "module": "experiments.cifar10.evaluate_rem",
  "shared": {
    "steps": "10,20,50,100,200,325",
    "t-end": 3.25,
    "time-cutoff": 1.0,
    "temperature-ramp-end": 1.0,
    "temperature-schedule": "official",
    "samples": 50000,
    "batch-size": 128,
    "warmup-batches": 1,
    "precision-recall": true,
    "divergence-samples": 1
  },
  "evaluations": [
    {
      "name": "em",
      "checkpoint-glob": "{training_output}/em_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "em_large",
      "checkpoint-glob": "{training_output}/em_large_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "em_compute_matched",
      "checkpoint-glob": "{training_output}/em_compute_matched_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "em_const",
      "checkpoint-glob": "{training_output}/em_const_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "rem_scalar",
      "checkpoint-glob": "{training_output}/rem_scalar_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "rem_diagonal",
      "checkpoint-glob": "{training_output}/rem_diagonal_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "rem_no_div",
      "checkpoint-glob": "{training_output}/rem_diagonal_seed*/checkpoints/latest.pt",
      "divergence-correction": false
    },
    {
      "name": "rem_unfixed",
      "checkpoint-glob": "{training_output}/rem_unfixed_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "rem_low_rank",
      "checkpoint-glob": "{training_output}/rem_low_rank_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    },
    {
      "name": "rem_joint",
      "checkpoint-glob": "{training_output}/rem_joint_seed*/checkpoints/latest.pt",
      "divergence-correction": true
    }
  ]
}
